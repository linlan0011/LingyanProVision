{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run full app (pose UI + live camera)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_app.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "--camera",
                "usb0bda3035_1080p",
                "--ranging",
                "--target-z-mm",
                "0"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "subProcess": true
        },
        {
            "name": "Field map pose selector",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/pose_map_gui.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "USB 1080p: front-facing",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/purple_camera_segmentation.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "--camera",
                "usb0bda3035_1080p",
                "--scene",
                "front-facing",
                "--ranging",
                "--target-z-mm",
                "0"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "USB 1080p: start-facing",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/purple_camera_segmentation.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "--camera",
                "usb0bda3035_1080p",
                "--scene",
                "start-facing",
                "--ranging",
                "--target-z-mm",
                "0"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "USB 1080p: general",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/purple_camera_segmentation.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "--camera",
                "usb0bda3035_1080p",
                "--scene",
                "general",
                "--ranging",
                "--target-z-mm",
                "0"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "Calibration: collect mount points (USB 1080p)",
            "type": "debugpy",
            "request": "launch",
            "module": "calibration.collect_mount_points",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "--camera",
                "usb0bda3035_1080p"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ]
}
