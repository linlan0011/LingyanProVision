{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Simulated pose + calibrated ranging (USB 1080p)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_app.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["--camera", "usb0bda3035_1080p", "--ranging", "--target-z-mm", "0"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "subProcess": true
        },
        {
            "name": "Run full app (pose UI + live camera)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_app.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "subProcess": true
        },
        {
            "name": "Calibration: collect mount points (LINGYAN)",
            "type": "debugpy",
            "request": "launch",
            "module": "calibration.collect_mount_points",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
