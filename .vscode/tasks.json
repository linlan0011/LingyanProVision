{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Camera: list registered profiles",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "camera_profiles",
                "list"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Camera: probe actual resolution",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "calibration.probe_camera",
                "--index",
                "${input:cameraIndex}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Calibration: capture selected camera chessboard",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "calibration.capture_chessboard",
                "--camera",
                "${input:cameraId}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Calibration: capture selected camera validation",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "calibration.capture_chessboard",
                "--camera",
                "${input:cameraId}",
                "--output",
                "calibration/data/${input:cameraId}/validation"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Calibration: solve selected camera intrinsics",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "calibration.calibrate_intrinsics",
                "--camera",
                "${input:cameraId}",
                "--square-mm",
                "${input:chessboardSquareMm}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Calibration: validate selected camera intrinsics",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "calibration.validate_intrinsics",
                "--camera",
                "${input:cameraId}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Calibration: collect selected camera mount points",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "calibration.collect_mount_points",
                "--camera",
                "${input:cameraId}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Calibration: fit selected camera mount pose",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "calibration.fit_mount_pose",
                "--camera",
                "${input:cameraId}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Calibration: collect selected camera ranging validation",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "calibration.collect_mount_points",
                "--camera",
                "${input:cameraId}",
                "--purpose",
                "validation"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Calibration: validate selected camera ranging",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "calibration.validate_ranging",
                "--camera",
                "${input:cameraId}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run recognition with selected camera",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "${workspaceFolder}\\run_app.py",
                "--camera",
                "${input:cameraId}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run full app (pose UI + live camera)",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "${workspaceFolder}\\run_app.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run field map pose selector",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "${workspaceFolder}\\pose_map_gui.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Test: all project checks",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-B",
                "-m",
                "unittest",
                "discover",
                "-p",
                "test_*.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "cameraId",
            "type": "promptString",
            "description": "Registered camera ID (python -m camera_profiles list)",
            "default": "usb0bda3035_1080p"
        },
        {
            "id": "cameraIndex",
            "type": "promptString",
            "description": "USB camera index",
            "default": "0"
        },
        {
            "id": "chessboardSquareMm",
            "type": "promptString",
            "description": "Measured chessboard square size in mm",
            "default": "20.0"
        }
    ]
}
