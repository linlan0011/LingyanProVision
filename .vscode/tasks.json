            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["-m", "calibration.collect_mount_points"],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
