            "args": [
                "${workspaceFolder}\\purple_camera_segmentation.py",
                "--camera",
                "seekfree",
                "--index",
                "0",
                "--scene",
                "front-facing"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
