    "inputs": [
        {
            "id": "calibrationCameraId",
            "type": "promptString",
            "description": "输入已注册相机 ID，例如 lingyan；用 python -m camera_profiles list 查看列表",
            "default": "lingyan"
        },
        {
            "id": "cameraIndex",
            "type": "promptString",
            "description": "USB 摄像头索引",
            "default": "0"
        },
        {
            "id": "cameraId", "type": "promptString",
            "description": "输入已登记相机 ID（如 lingyan、seekfree 或新相机 ID）",
            "default": "lingyan"
        },
        {
            "id": "cameraIndex", "type": "promptString",
            "description": "输入待探测摄像头设备序号",
            "default": "0"
        },
        {
            "id": "chessboardSquareMm",
            "type": "promptString",
            "description": "请输入打印后实测的棋盘格单格边长（mm），不可直接用标称值",
            "default": "20.0"
        }
    ]
}
