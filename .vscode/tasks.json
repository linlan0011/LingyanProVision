                "${workspaceFolder}\\purple_camera_segmentation.py",
                "--camera",
                "lingyan",
                "--index",
                "0",
                "--scene",
                "front-facing"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run purple camera segmentation (LINGYAN legacy side)",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "${workspaceFolder}\\purple_camera_segmentation.py",
                "--camera",
                "lingyan",
                "--index",
                "0",
                "--scene",
                "start-facing"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
