            "args": [
                "-m",
                "calibration.capture_chessboard",
                "--camera",
                "lingyan",
                "--index",
                "0"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
