            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["${workspaceFolder}\\purple_camera_segmentation.py", "--camera", "${input:calibrationCameraId}", "--scene", "auto"],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
        },
        {
            "label": "Camera: run full app with selected profile",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["${workspaceFolder}\\run_app.py", "--camera", "${input:calibrationCameraId}"],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
        },
        {
            "label": "Calibration: capture selected camera chessboard",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["-m", "calibration.capture_chessboard", "--camera", "${input:calibrationCameraId}"],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
        },
        {
            "label": "Calibration: capture selected camera validation images",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["-m", "calibration.capture_chessboard", "--camera", "${input:calibrationCameraId}", "--output", "calibration/data/${input:calibrationCameraId}/validation"],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
        },
        {
            "label": "Calibration: solve selected camera intrinsics",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["-m", "calibration.calibrate_intrinsics", "--camera", "${input:calibrationCameraId}", "--square-mm", "${input:chessboardSquareMm}"],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
        },
        {
            "label": "Calibration: validate selected camera intrinsics",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["-m", "calibration.validate_intrinsics", "--camera", "${input:calibrationCameraId}"],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
        },
        {
            "label": "Calibration: collect selected camera mount points",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["-m", "calibration.collect_mount_points", "--camera", "${input:calibrationCameraId}"],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
        },
        {
            "label": "Calibration: fit selected camera mount pose",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["-m", "calibration.fit_mount_pose", "--camera", "${input:calibrationCameraId}"],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
