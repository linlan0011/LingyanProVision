# Local camera captures, screenshots and diagnostic images.
/照片/*
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff
*.webp
*.PNG
*.JPG
*.JPEG
*.BMP
*.TIF
*.TIFF
*.WEBP

# Required map resource used by the pose selector.
!照片/field_map.png

# Local runtime and diagnostic logs.
*.log
*.log.*
*.LOG

# Local environments and runtime state.
/.venv/
/selected_pose.json

# Generated feedback, reports, replay results and temporary diagnostics.
/output/
/outputs/
/tmp/

# Camera captures, exports and calibration history stay local.
/calibration/data/
/calibration/archives/
/calibration/backups/
/calibration/benchmarks/
/calibration/results/*/*
!/calibration/results/*/intrinsics.json
!/calibration/results/*/mount_pose.json

# Generated Python caches.
__pycache__/
*.py[cod]
